FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod ./
COPY *.go ./
RUN go mod tidy
RUN go test ./...
RUN CGO_ENABLED=0 go build -o log-api-service .

FROM alpine:latest

WORKDIR /app

COPY --from=builder /app/log-api-service .

ENTRYPOINT ["/app/log-api-service"]
